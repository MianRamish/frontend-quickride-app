# Local backend
VITE_SERVER_URL=http://localhost:4000

# For temporary public testing, replace with your backend tunnel URL, for example:
# VITE_SERVER_URL=https://your-backend-url.ngrok-free.app
# VITE_SERVER_URL=https://your-backend-url.trycloudflare.com

VITE_RIDE_TIMEOUT=90000

# Nigeria frontend defaults are currently set in the React UI:
# Currency: NGN | Map fallback center: Lagos | Distance display: kilometres

# Passenger payment mode
VITE_PAYMENT_MODE=cash
